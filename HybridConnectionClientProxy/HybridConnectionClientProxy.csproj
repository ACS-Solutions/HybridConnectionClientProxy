<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UserSecretsId>eb380b7a-0bcd-4399-84ef-0d994ab63de3</UserSecretsId>
    <!-- Overridden from the release tag: dotnet publish -p:Version=1.2.3 -->
    <Version>0.0.0-dev</Version>
    <!-- Keep the informational version (printed by the version switch) identical to the tag -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Expose internals to the test project -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>HybridConnectionClientProxy.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="../.github/workflows/dotnet.yml" />
    <None Include="../.github/workflows/release.yml" />
  </ItemGroup>

  <ItemGroup>
    <!-- Azure.Identity: Entra ID sign-in (EntraId settings) -->
    <PackageReference Include="Azure.Identity" Version="1.21.0" />
    <PackageReference Include="Microsoft.Azure.Relay" Version="3.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.CommandLine" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="10.0.1" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <!--
    Version alignment, not used directly. Microsoft.Azure.Relay 3.1.1 (the latest) depends on
    System.IdentityModel.Tokens.Jwt 6.36.0, while Azure.Identity's MSAL brings Microsoft.IdentityModel.Abstractions 8.x.
    Microsoft.IdentityModel packages should all be one version, so these lift the 6.x ones to match (and let Dependabot
    keep them current). They were first added to lift versions with known vulnerabilities; as of 11 Nov 2026 without them
    "dotnet list package" with the vulnerable and include-transitive options reports nothing, and the tests pass. When
    Microsoft.Azure.Relay moves to 8.x, remove them. Azure.Core needs no pin: Azure.Identity, referenced directly above,
    decides its version.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- Windows-only defaults (file logging under %TEMP%, debugger output); not shipped in non-Windows publishes -->
    <None Update="appsettings.Windows.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory Condition="'$(RuntimeIdentifier)' != '' And !$(RuntimeIdentifier.StartsWith('win'))">Never</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="logs/" />
  </ItemGroup>

</Project>
